// ===== 레일 플랫폼 방식 공용 파라미터 =====
// 핵심 개념: 침대를 들지 않고 굴려서 올라가는 2개의 계량 레일.
//   각 레일 = 알루미늄 프로파일 빔 + 양 끝단 아래 로드셀 2개
//   침대 좌/우 바퀴가 각각 레일 위를 굴러 들어가 크래들에 안착.
//   총 로드셀 4개 = 좌레일 앞/뒤 + 우레일 앞/뒤
//   총중량 = 4개 합 / 무게중심 = 모멘트 계산

// --- 로드셀 CAS BCA-100L ---
L_len=150; L_wid=35; L_thk=40;
L_pitch_x=19; L_pitch_y=15;
L_free_x1=16.5; L_free_x2=35.5;   // 자유단(상면 탭)
L_fix_x1=114.5; L_fix_x2=133.5;   // 고정단(하면 탭)

// --- 스택 높이 ---
PAD_thk    = 6;    // 바닥 패드 두께
FOOT_h     = 2.5;  // 패드 하면 지지 발 높이 (전면접촉 대신 4점 지지)
FOOT_d     = 12;   // 지지 발 지름
SPACER_h   = 5;    // 로드셀 고정단 단상
// --- 어댑터 플레이트(구 bracket) : 로드셀 자유단 상면 <-> 레일 연결 ---
// PDF 부품목록 확정치 80x80x12. 로드셀 40mm 대응 + 자유단 체결홀이 바퀴
// 슬롯을 관통하지 않도록 레일 체결점을 수평 이격시키는 오프셋 캔틸레버.
ADP_l      = 80;   // 어댑터 길이(로드셀 길이방향, 오프셋이 생기는 축)
ADP_w      = 80;   // 어댑터 폭
ADP_t      = 12;   // 어댑터 두께(=구 BRACKET_t 대체). 12mm라 굽힘강성 충분
ADP_OFFSET = 30;   // ★임의값★ 자유단 홀 중심 ↔ 레일 체결부 중심 오프셋(mm)
                   //   실측 확정 필요(MEASUREMENTS_TODO C1/C2). 슬롯 반대쪽으로.
BRACKET_t  = ADP_t;  // 스택 계산 호환용 별칭 (기존 DECK_Z 식 유지)
RAIL_h     = 30;   // 알루미늄 프로파일 높이 (30x60 사용)
RAIL_w     = 60;   // 프로파일 폭 (바퀴 두께 22mm + 여유)
DECK_Z = PAD_thk + SPACER_h + L_thk + BRACKET_t + RAIL_h;   // 6+5+40+12+30 = 93
// (원 설계 87: 브래킷6. 개선으로 어댑터 12mm 도입 -> 93. 램프 길이 자동 연동)
// 주: 패드 하면 지지 발(FOOT_h) 때문에 4개 채널 모두 절대 높이가 FOOT_h 만큼
//     동일하게 올라간다. 로드셀 상호 수평/정합은 유지되고(전부 같이 올라감),
//     절대 데크 높이만 DECK_Z + FOOT_h 가 된다. 램프는 하중경로 분리부품이라
//     이 2.5mm 차이는 무시 가능(15° 경사에서 미소).

// --- 레일 전체 ---
CASTER_PITCH = 1700;   // 침대 앞뒤 캐스터 간격
RAMP_ANG = 15;
RAMP_len = DECK_Z / tan(RAMP_ANG);      // 약 325mm
RAIL_len = CASTER_PITCH + 400;          // 캐스터간격 + 양끝 여유

// --- 바퀴 ---
wheel_d=60; wheel_thk=22;   // 실측 후 교체
CRADLE_depth = 9;           // 얕은 크래들: 굴러 넘어갈 수 있되 안착은 되게
