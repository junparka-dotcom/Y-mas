// ===== 레일 플랫폼 방식 공용 파라미터 =====
// 핵심 개념: 침대를 들지 않고 굴려서 올라가는 2개의 계량 레일.
//   각 레일 = 알루미늄 프로파일 빔 + 양 끝단 아래 로드셀 2개
//   침대 좌/우 바퀴가 각각 레일 위를 굴러 들어가 크래들에 안착.
//   총 로드셀 4개 = 좌레일 앞/뒤 + 우레일 앞/뒤
//   총중량 = 4개 합 / 무게중심 = 모멘트 계산

// --- 로드셀 CAS BCA-100L ---
L_len=150; L_wid=35; L_thk=40;
L_pitch_x=19; L_pitch_y=15;
L_free_x1=16.5; L_free_x2=35.5;   // 자유단(상면 탭)
L_fix_x1=114.5; L_fix_x2=133.5;   // 고정단(하면 탭)

// --- 스택 높이 ---
PAD_thk    = 6;    // 바닥 패드 두께
SPACER_h   = 5;    // 로드셀 고정단 단상
BRACKET_t  = 6;    // 레일-로드셀 연결 브래킷 두께
RAIL_h     = 30;   // 알루미늄 프로파일 높이 (30x60 사용)
RAIL_w     = 60;   // 프로파일 폭 (바퀴 두께 22mm + 여유)
DECK_Z = PAD_thk + SPACER_h + L_thk + BRACKET_t + RAIL_h;   // = 87

// --- 레일 전체 ---
CASTER_PITCH = 1700;   // 침대 앞뒤 캐스터 간격
RAMP_ANG = 15;
RAMP_len = DECK_Z / tan(RAMP_ANG);      // 약 325mm
RAIL_len = CASTER_PITCH + 400;          // 캐스터간격 + 양끝 여유

// --- 바퀴 ---
wheel_d=60; wheel_thk=22;   // 실측 후 교체
CRADLE_depth = 9;           // 얕은 크래들: 굴러 넘어갈 수 있되 안착은 되게
