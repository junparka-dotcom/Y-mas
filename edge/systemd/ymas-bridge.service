[Unit]
Description=Y-mas Tier2 - Orbbec IR+Depth C++ bridge (camera capture)
Documentation=https://github.com/junparka-dotcom/Y-mas
# 부팅 시 USB 카메라가 준비된 뒤 시작하도록
After=multi-user.target
Wants=multi-user.target
# 짧은 시간에 반복 실패해도 계속 재시도 (재시작 제한 해제) — [Unit] 섹션에 위치해야 함
StartLimitIntervalSec=0

[Service]
Type=simple
User=ymas
Group=ymas
WorkingDirectory=/home/ymas/Y-mas/edge/bridges

# 재시작 전 잔여 소켓 정리(오래된 /tmp/ymas_irdepth.sock 제거)
ExecStartPre=/bin/rm -f /tmp/ymas_irdepth.sock
ExecStart=/home/ymas/Y-mas/edge/bridges/ir_depth_bridge

# 크래시/카메라 오류 시 자동 재시작 (USB 워밍업 여유 두고 재시도)
Restart=always
RestartSec=3

# 로그는 journald 로 (journalctl -u ymas-bridge)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
